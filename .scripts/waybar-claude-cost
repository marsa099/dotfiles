#!/usr/bin/env python3
"""Live Claude Code cost from Claude's status-line cumulative cost counters.

No transcripts are scanned. `claude-cost-record`, called by the configured
status-line command, baselines each local session and records later increases.
The OAuth usage endpoint supplies authoritative account utilization and actual
extra-credit spend for the tooltip; it does not expose daily token/cost history.
"""
import json
import os
import sys
import time
import urllib.request
from datetime import datetime

STATE_DIR = os.path.expanduser("~/.cache/waybar-claude-cost")
RUNTIME_FILE = os.path.join(STATE_DIR, "runtime.json")
CURRENCY_FILE = os.path.join(STATE_DIR, "currency")
RATE_FILE = os.path.join(STATE_DIR, "usd_sek")
CREDENTIALS = os.path.expanduser("~/.claude/.credentials.json")
RATE_URL = "https://open.er-api.com/v6/latest/USD"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
FALLBACK_RATE = 9.6
FETCH_INTERVAL = 300


def read_text(path, default=""):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def toggle_currency():
    os.makedirs(STATE_DIR, exist_ok=True)
    new = "SEK" if read_text(CURRENCY_FILE, "USD") == "USD" else "USD"
    with open(CURRENCY_FILE, "w") as fh:
        fh.write(new)


def load_runtime():
    try:
        with open(RUNTIME_FILE) as fh:
            data = json.load(fh)
        if data.get("version") == 1:
            return data
    except (OSError, ValueError):
        pass
    return {"days": {}, "sessions": {}, "started_at": None}


def usd_rate():
    try:
        cached = float(read_text(RATE_FILE))
    except ValueError:
        cached = FALLBACK_RATE
    try:
        if time.time() - os.path.getmtime(RATE_FILE) < 12 * 3600:
            return cached
    except OSError:
        pass
    try:
        with urllib.request.urlopen(RATE_URL, timeout=3) as response:
            rate = float(json.load(response)["rates"]["SEK"])
        with open(RATE_FILE, "w") as fh:
            fh.write(f"{rate:.4f}")
        return rate
    except Exception:
        return cached


def fetch_account_usage():
    try:
        with open(CREDENTIALS) as fh:
            token = json.load(fh)["claudeAiOauth"]["accessToken"]
        request = urllib.request.Request(USAGE_URL, headers={
            "Authorization": "Bearer " + token,
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "claude-code-cost-bar",
            "Content-Type": "application/json",
        })
        with urllib.request.urlopen(request, timeout=5) as response:
            return json.load(response)
    except Exception:
        return None


def money(usd, currency, rate):
    if currency == "SEK":
        return f"{usd * rate:,.2f}".replace(",", " ").replace(".", ",") + " kr"
    return f"${usd:,.2f}"


def reset_text(value):
    if not value:
        return ""
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone()
        return dt.strftime("%a %H:%M")
    except (ValueError, AttributeError):
        return ""


def account_lines(usage):
    if not usage:
        return ["Account usage: unavailable"]
    lines = ["Official account usage:"]
    for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
        item = usage.get(key) or {}
        if item.get("utilization") is not None:
            reset = reset_text(item.get("resets_at"))
            lines.append(f"  {label}: {item['utilization']:.0f}%" + (f"  (resets {reset})" if reset else ""))
    spend = usage.get("spend") or {}
    used = spend.get("used") or {}
    if used.get("amount_minor") is not None:
        amount = used["amount_minor"] / (10 ** int(used.get("exponent", 2)))
        symbol = {"EUR": "€", "USD": "$", "SEK": "kr "}.get(used.get("currency"), used.get("currency", "") + " ")
        lines.append(f"  Actual extra credits used: {symbol}{amount:.2f}")
    return lines


def emit(account):
    state = load_runtime()
    days = {day: float(value) for day, value in (state.get("days") or {}).items()}
    today = datetime.now().strftime("%Y-%m-%d")
    today_cost = days.get(today, 0.0)
    total = sum(days.values())
    currency = read_text(CURRENCY_FILE, "USD") or "USD"
    rate = usd_rate() if currency == "SEK" else 1.0

    started = state.get("started_at")
    try:
        since = datetime.fromisoformat(started).astimezone().strftime("%Y-%m-%d %H:%M") if started else "waiting for first update"
    except ValueError:
        since = "unknown"
    lines = [
        "Claude Code · local API-equivalent cost",
        f"Today:  {money(today_cost, currency, rate)}",
        f"Since cutover:  {money(total, currency, rate)}",
        f"Tracking since:  {since}",
        "",
        *account_lines(account),
        "",
        "Local cost includes Remote-Control turns handled on this computer.",
        "It excludes Claude sessions running on other machines or in the cloud.",
        "Click: USD ⇄ SEK",
    ]
    cls = "high" if today_cost >= 100 else "medium" if today_cost >= 25 else "low"
    return json.dumps({"text": " " + money(today_cost, currency, rate),
                       "tooltip": "\n".join(lines), "class": cls})


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    account = None
    next_fetch = 0.0
    previous = None
    print(json.dumps({"text": " …", "class": "low"}), flush=True)
    while True:
        now = time.time()
        if now >= next_fetch:
            fetched = fetch_account_usage()
            if fetched is not None:
                account = fetched
            next_fetch = now + FETCH_INTERVAL
        output = emit(account)
        if output != previous:
            print(output, flush=True)
            previous = output
        time.sleep(2)


if __name__ == "__main__":
    if "--toggle" in sys.argv[1:]:
        toggle_currency()
    else:
        try:
            main()
        except (KeyboardInterrupt, BrokenPipeError):
            pass
