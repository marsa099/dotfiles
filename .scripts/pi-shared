#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const VERSION = "0.3.0";
const SESSION_PREFIX = "pi-remote-";

function extensionServerPath(env = process.env, home = os.homedir()) {
  return env.PI_REMOTE_SERVER_MODULE || path.join(home, ".pi", "agent", "extensions", "pi-remote", "server.cjs");
}

function loadRemoteConfig(env = process.env, home = os.homedir()) {
  const modulePath = extensionServerPath(env, home);
  if (!fs.existsSync(modulePath)) throw new Error(`Pi Remote extension is missing: ${modulePath}`);
  const { readOrCreateConfig } = require(modulePath);
  return readOrCreateConfig(env, home);
}

function defaultSessionName(cwd) {
  return path.basename(path.resolve(cwd)) || "home";
}

function tmuxSessionName(name) {
  const safe = String(name)
    .normalize("NFKD")
    .replace(/[^a-zA-Z0-9_-]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 64);
  if (!safe) throw new Error("Session name must contain a letter or number");
  return `${SESSION_PREFIX}${safe}`;
}

function parseArguments(argv, cwd = process.cwd()) {
  const separator = argv.indexOf("--");
  const wrapperArgs = separator >= 0 ? argv.slice(0, separator) : [...argv];
  const piArgs = separator >= 0 ? argv.slice(separator + 1) : [];

  if (wrapperArgs.includes("-h") || wrapperArgs.includes("--help")) return { command: "help", piArgs: [] };
  if (wrapperArgs.includes("-v") || wrapperArgs.includes("--version")) return { command: "version", piArgs: [] };

  const commands = new Set(["attach", "help", "kill", "list", "migrate", "new", "open", "qr", "token", "url", "version"]);
  const first = wrapperArgs[0];
  const command = first && commands.has(first) ? first : "open";
  const positionals = command === "open" ? wrapperArgs : wrapperArgs.slice(1);

  if (["help", "list", "qr", "token", "url", "version"].includes(command) && (positionals.length > 0 || piArgs.length > 0)) {
    throw new Error(`${command} does not accept arguments`);
  }
  if (["attach", "kill"].includes(command)) {
    if (positionals.length !== 1 || piArgs.length > 0) throw new Error(`Usage: pi-shared ${command} <name>`);
    return { command, reference: positionals[0], piArgs: [] };
  }
  if (command === "migrate") {
    if (positionals.length > 1 || piArgs.length > 0) throw new Error("Usage: pi-shared migrate [session-file-or-id]");
    return { command, reference: positionals[0] || null, piArgs: [] };
  }
  if (["new", "open"].includes(command)) {
    if (positionals.length > 1) throw new Error(`Usage: pi-shared ${command === "open" ? "[name]" : "new [name]"} [-- <pi-arguments>]`);
    return { command, name: positionals[0] || defaultSessionName(cwd), piArgs };
  }
  return { command, piArgs };
}

function runTmux(args, options = {}) {
  const result = spawnSync("tmux", args, {
    encoding: "utf8",
    stdio: options.inherit ? "inherit" : ["ignore", "pipe", "pipe"],
  });
  if (result.error) throw result.error;
  if (result.status !== 0 && !options.allowFailure) {
    throw new Error((result.stderr || result.stdout || `tmux exited with status ${result.status}`).trim());
  }
  return result;
}

function listSessions() {
  const result = runTmux(
    ["list-sessions", "-F", "#{session_name}\t#{session_path}\t#{@pi_remote_name}"],
    { allowFailure: true },
  );
  if (result.status !== 0) return [];
  return result.stdout
    .trim()
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [tmuxName, cwd, displayName] = line.split("\t");
      return { tmuxName, cwd, name: displayName || tmuxName.replace(SESSION_PREFIX, "") };
    })
    .filter((session) => session.tmuxName.startsWith(SESSION_PREFIX));
}

function resolveSession(reference, sessions) {
  const query = reference.toLowerCase();
  const exact = sessions.filter(
    (session) => session.name.toLowerCase() === query || session.tmuxName.toLowerCase() === query,
  );
  if (exact.length === 1) return exact[0];
  if (exact.length > 1) throw new Error(`Session name is ambiguous: ${reference}`);
  const partial = sessions.filter(
    (session) => session.name.toLowerCase().includes(query) || session.tmuxName.toLowerCase().includes(query),
  );
  if (partial.length === 1) return partial[0];
  if (partial.length > 1) throw new Error(`Session name is ambiguous: ${reference}`);
  return null;
}

function remoteUrl(config) {
  const host = config.host.includes(":") && !config.host.startsWith("[") ? `[${config.host}]` : config.host;
  return `http://${host}:${config.port}`;
}

function pairingUrl(config, code) {
  return `${remoteUrl(config)}/#pair=${encodeURIComponent(code)}`;
}

async function requestPairingCode(config, fetchImplementation = globalThis.fetch) {
  let response;
  try {
    response = await fetchImplementation(`${remoteUrl(config)}/api/pair`, {
      method: "POST",
      headers: { Authorization: `Bearer ${config.token}` },
      signal: AbortSignal.timeout(5000),
    });
  } catch (error) {
    throw new Error(`Pi Remote is not reachable at ${remoteUrl(config)}. Start the shared session, then retry.`, { cause: error });
  }
  if (!response.ok) {
    throw new Error(`Pi Remote refused QR pairing (${response.status})`);
  }
  const payload = await response.json();
  if (typeof payload.code !== "string" || !payload.code) throw new Error("Pi Remote returned an invalid pairing code");
  return payload;
}

function renderQr(url, env = process.env, spawn = spawnSync) {
  const args = ["-t", "ANSIUTF8", "-l", "M", "-m", "2", "-o", "-", url];
  const configured = env.PI_REMOTE_QRENCODE;
  let command = configured || "qrencode";
  let commandArgs = args;
  let result = spawn(command, commandArgs, { stdio: "inherit" });
  if (!configured && result.error?.code === "ENOENT") {
    command = "nix";
    commandArgs = ["run", "nixpkgs#qrencode", "--", ...args];
    result = spawn(command, commandArgs, { stdio: "inherit" });
  }
  if (result.error) throw result.error;
  if (result.status !== 0) throw new Error(`${command} exited with status ${result.status}`);
}

async function printPairingQr(env = process.env, home = os.homedir()) {
  const config = loadRemoteConfig(env, home);
  const pairing = await requestPairingCode(config);
  process.stdout.write("Scan with your phone camera. This code works once and expires in 2 minutes.\n\n");
  renderQr(pairingUrl(config, pairing.code), env);
}

function sessionRoot(env = process.env, home = os.homedir()) {
  return env.PI_SHARED_SESSION_ROOT || path.join(home, ".pi", "agent", "sessions");
}

function listSessionFiles(root) {
  if (!fs.existsSync(root)) return [];
  const files = [];
  const directories = [root];
  while (directories.length > 0) {
    const directory = directories.pop();
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const file = path.join(directory, entry.name);
      if (entry.isDirectory()) directories.push(file);
      else if (entry.isFile() && entry.name.endsWith(".jsonl")) {
        files.push({ file, mtimeMs: fs.statSync(file).mtimeMs });
      }
    }
  }
  return files.sort((left, right) => right.mtimeMs - left.mtimeMs);
}

function readSessionMetadata(file) {
  const descriptor = fs.openSync(file, "r");
  try {
    const buffer = Buffer.alloc(32 * 1024);
    const bytes = fs.readSync(descriptor, buffer, 0, buffer.length, 0);
    const lines = buffer.subarray(0, bytes).toString("utf8").split("\n").slice(0, 32);
    let header = null;
    let name = null;
    for (const line of lines) {
      if (!line) continue;
      let entry;
      try { entry = JSON.parse(line); } catch { continue; }
      if (entry.type === "session" && !header) header = entry;
      if (entry.type === "session_info" && typeof entry.name === "string") name = entry.name;
      if (header && name) break;
    }
    if (!header || typeof header.id !== "string" || typeof header.cwd !== "string") {
      throw new Error(`Not a Pi session file: ${file}`);
    }
    return { file, id: header.id, cwd: header.cwd, name: name || path.basename(header.cwd) || "migrated" };
  } finally {
    fs.closeSync(descriptor);
  }
}

function resolveMigrationSession(reference, env = process.env, home = os.homedir()) {
  if (reference) {
    const direct = path.resolve(reference);
    if (fs.existsSync(direct) && fs.statSync(direct).isFile()) return readSessionMetadata(direct);
  }
  const files = listSessionFiles(sessionRoot(env, home));
  if (files.length === 0) throw new Error("No Pi session files were found");
  if (!reference) return readSessionMetadata(files[0].file);
  const matches = files.filter(({ file }) => path.basename(file).toLowerCase().includes(reference.toLowerCase()));
  if (matches.length === 0) throw new Error(`Pi session not found: ${reference}`);
  if (matches.length > 1) throw new Error(`Pi session reference is ambiguous: ${reference}`);
  return readSessionMetadata(matches[0].file);
}

function activeSessionPids(file, procRoot = "/proc") {
  const target = path.resolve(file);
  const pids = [];
  let entries;
  try { entries = fs.readdirSync(procRoot, { withFileTypes: true }); } catch { return pids; }
  for (const entry of entries) {
    if (!entry.isDirectory() || !/^\d+$/.test(entry.name)) continue;
    try {
      const processRoot = path.join(procRoot, entry.name);
      const environment = fs.readFileSync(path.join(processRoot, "environ"), "utf8").split("\0");
      const sessionValue = environment.find((value) => value.startsWith("PI_SESSION_FILE="))?.slice(16);
      const command = fs.readFileSync(path.join(processRoot, "cmdline"), "utf8").split("\0");
      if ((sessionValue && path.resolve(sessionValue) === target) || command.includes(target)) pids.push(Number(entry.name));
    } catch {
      // Processes can exit or deny inspection while /proc is being scanned.
    }
  }
  return pids;
}

function printSessions(sessions) {
  if (sessions.length === 0) {
    process.stdout.write("No Pi Remote sessions.\n");
    return;
  }
  process.stdout.write("NAME                         CWD\n");
  for (const session of sessions) {
    process.stdout.write(`${session.name.slice(0, 28).padEnd(28)} ${session.cwd || "-"}\n`);
  }
}

function createSession(input, env = process.env, home = os.homedir()) {
  const piBinary = env.PI_SHARED_PI || path.join(home, ".npm-global", "bin", "pi");
  if (!fs.existsSync(piBinary)) throw new Error(`Pi binary not found: ${piBinary}`);
  const tmuxName = tmuxSessionName(input.name);
  const hasExplicitName = input.piArgs.some((argument) => argument === "--name" || argument === "-n");
  const piArgs = ["--remote", ...(hasExplicitName ? [] : ["--name", input.name]), ...input.piArgs];

  runTmux(["new-session", "-d", "-s", tmuxName, "-c", input.cwd, "--", piBinary, ...piArgs]);
  try {
    runTmux(["set-option", "-t", tmuxName, "@pi_remote_name", input.name]);
  } catch (error) {
    runTmux(["kill-session", "-t", tmuxName], { allowFailure: true });
    throw error;
  }
  return { tmuxName, cwd: input.cwd, name: input.name };
}

function attachSession(session, env = process.env) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) throw new Error("pi-shared attach requires an interactive terminal");
  if (env.TMUX) {
    runTmux(["switch-client", "-t", session.tmuxName], { inherit: true });
  } else {
    runTmux(["attach-session", "-t", session.tmuxName], { inherit: true });
  }
}

function printHelp() {
  process.stdout.write(`pi-shared ${VERSION} — native laptop Pi plus an independent mobile web renderer\n\n`);
  process.stdout.write("Usage:\n");
  process.stdout.write("  pi-shared [name] [-- <pi-arguments>]   Attach, or create if missing\n");
  process.stdout.write("  pi-shared new [name] [-- <pi-arguments>]\n");
  process.stdout.write("  pi-shared attach <name>\n");
  process.stdout.write("  pi-shared list\n");
  process.stdout.write("  pi-shared kill <name>\n");
  process.stdout.write("  pi-shared migrate [session]     Reopen a legacy session remotely\n");
  process.stdout.write("  pi-shared qr                    Scan to sign in on a phone\n");
  process.stdout.write("  pi-shared url\n");
  process.stdout.write("  pi-shared token                 Manual fallback\n\n");
  process.stdout.write("Detach the laptop with Ctrl-B then D. Pi keeps running in tmux.\n");
  process.stdout.write("The phone connects to the URL and renders semantic events independently.\n");
}

async function run(argv = process.argv.slice(2), env = process.env, home = os.homedir()) {
  const parsed = parseArguments(argv);
  if (parsed.command === "help") return printHelp();
  if (parsed.command === "version") return process.stdout.write(`${VERSION}\n`);
  if (parsed.command === "qr") return printPairingQr(env, home);
  if (parsed.command === "token") return process.stdout.write(`${loadRemoteConfig(env, home).token}\n`);
  if (parsed.command === "url") return process.stdout.write(`${remoteUrl(loadRemoteConfig(env, home))}\n`);

  const sessions = listSessions();
  if (parsed.command === "list") return printSessions(sessions);
  if (parsed.command === "migrate") {
    if (sessions.length > 0) {
      throw new Error(`A Pi Remote session already exists: ${sessions[0].name}`);
    }
    const legacy = resolveMigrationSession(parsed.reference, env, home);
    const activePids = activeSessionPids(legacy.file, env.PI_SHARED_PROC_ROOT || "/proc");
    if (activePids.length > 0) {
      throw new Error(`Session is still running (PID ${activePids.slice(0, 3).join(", ")}). Exit the old Pi, then run pi-shared migrate again.`);
    }
    process.stdout.write(`Migrating ${legacy.name}: ${legacy.file}\n`);
    const migrated = createSession({ cwd: legacy.cwd, name: legacy.name, piArgs: ["--session", legacy.file] }, env, home);
    return attachSession(migrated, env);
  }
  if (parsed.command === "attach" || parsed.command === "kill") {
    const session = resolveSession(parsed.reference, sessions);
    if (!session) throw new Error(`Pi Remote session not found: ${parsed.reference}`);
    if (parsed.command === "kill") {
      runTmux(["kill-session", "-t", session.tmuxName]);
      process.stdout.write(`Killed ${session.name}\n`);
      return;
    }
    return attachSession(session, env);
  }

  const tmuxName = tmuxSessionName(parsed.name);
  let session = sessions.find((candidate) => candidate.tmuxName === tmuxName) || null;
  if (parsed.command === "new" && session) throw new Error(`Pi Remote session already exists: ${parsed.name}`);
  if (session && parsed.piArgs.length > 0) {
    throw new Error(`Pi Remote session ${parsed.name} already exists; Pi arguments only apply when creating it`);
  }
  if (!session && sessions.length > 0) {
    throw new Error(`Pi Remote currently supports one shared session. Attach ${sessions[0].name} or kill it first.`);
  }
  if (!session) session = createSession({ cwd: process.cwd(), name: parsed.name, piArgs: parsed.piArgs }, env, home);
  return attachSession(session, env);
}

if (require.main === module) {
  run().catch((error) => {
    process.stderr.write(`pi-shared: ${error instanceof Error ? error.message : String(error)}\n`);
    process.exitCode = 1;
  });
}

module.exports = {
  SESSION_PREFIX,
  activeSessionPids,
  defaultSessionName,
  extensionServerPath,
  listSessionFiles,
  loadRemoteConfig,
  pairingUrl,
  parseArguments,
  remoteUrl,
  readSessionMetadata,
  renderQr,
  requestPairingCode,
  resolveMigrationSession,
  resolveSession,
  sessionRoot,
  tmuxSessionName,
};
